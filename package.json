{
  "name": "dsh-spinner-words",
  "version": "0.1.2",
  "type": "module",
  "main": "index.js",
  "description": "DeepSeek Harness 纯插件：思考状态行文案轮换。词池 = Claude Code 原版 179 条 spinner verbs + 13 条鲸鱼系 deep 短语 + 中国本土文化词（成语/典故/诗词/生活场景），英中双语一一对应，回合开场随机一条，回合内随新思考段/工具调用切换（最短间隔 3 秒），点击状态行切换中英文，不改 DSH 源码。",
  "license": "MIT",
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "status",
    "spinner",
    "spinner-words",
    "claude-code",
    "chinese-culture"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
