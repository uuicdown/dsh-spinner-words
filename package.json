{
  "name": "dsh-spinner-words",
  "version": "0.8.6",
  "type": "module",
  "main": "index.js",
  "description": "DeepSeek Harness 插件：把思考状态行换成 287 条双语轮换词（Claude Code 158 + 鲸鱼系 13 + 中国本土雅 86 / 俗 30），一回合一个词，点击状态行切中英，词池可在前端编辑（双击 / Alt+E）。不改 DSH 源码。",
  "license": "MIT",
  "author": "Soren (uuicdown) <2442707761@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuicdown/dsh-spinner-words.git"
  },
  "homepage": "https://github.com/uuicdown/dsh-spinner-words#readme",
  "bugs": {
    "url": "https://github.com/uuicdown/dsh-spinner-words/issues"
  },
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "status-line",
    "spinner",
    "spinner-words",
    "spinner-verbs",
    "thinking-words",
    "bilingual",
    "chinese",
    "claude-code",
    "chinese-culture",
    "word-pool"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "DEVELOPING.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "manifestVersion": 1
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
